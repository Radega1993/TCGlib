# Cópialo a .env en el VPS. No subas el .env al repositorio.
# La contraseña solo puede llevar letras y números: entra tal cual en la URI de Mongo.

MONGO_ROOT_USERNAME=tcglib
MONGO_ROOT_PASSWORD=cambia-esta-clave
MONGO_DATABASE=tcglib

APITCG_BASE_URL=https://api.apitcg.com
APITCG_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_STATE_SECRET=cambia-esta-cadena-larga

# Correos de Google que pueden entrar en /admin, separados por comas.
ADMIN_EMAILS=
