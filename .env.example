# Docker Compose lee este fichero desde la raíz del proyecto.
MONGO_ROOT_USERNAME=tcglib
MONGO_ROOT_PASSWORD=tcglib
MONGO_DATABASE=tcglib
MONGODB_URI=mongodb://tcglib:tcglib@localhost:27018/tcglib?authSource=admin

# https://apitcg.com/platform/api-key
APITCG_BASE_URL=https://api.apitcg.com
APITCG_API_KEY=replace-me

PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Cliente OAuth web de Google. URI de redirección:
# http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
AUTH_STATE_SECRET=replace-with-a-long-random-string
